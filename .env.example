# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host port the app is published on.
APP_PORT=4409

# Time zone the library is in; due dates are worked out in it.
LIBRARY_TIMEZONE=UTC

# debug, info, warn or error
LOG_LEVEL=info

# Set to true when the app is served over https so cookies are marked Secure.
SECURE_COOKIES=false
